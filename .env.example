# Content Munch Studio - Environment Configuration Example
PORT=3001
NODE_ENV=production
JWT_SECRET=content_munch_super_secret_jwt_key_2026

# Studio Operating Parameters (Overridable via Admin Dashboard)
STUDIO_TIMEZONE=Asia/Kolkata
STUDIO_BASE_HOURLY_RATE=1499
STUDIO_TAX_PERCENTAGE=18

# Supabase / PostgreSQL Credentials (if deploying with cloud Postgres)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
